@model SchoolDomain.Model.Review

@{
    ViewData["Title"] = "Додати відгук";
}

<h1>Додати відгук</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="TeacherId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Rating" class="control-label">Оцінка</label>
        <div class="star-rating">
            @for (int i = 1; i <= 5; i++)
            {
                <input type="radio" asp-for="Rating" value="@i" id="rating-@i" required />
                <label for="rating-@i" class="star">&#9733;</label>
            }
        </div>
        <span asp-validation-for="Rating" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Comment" class="control-label">Коментар</label>
        <textarea asp-for="Comment" class="form-control" required></textarea>
        <span asp-validation-for="Comment" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="submit" value="Зберегти" class="btn btn-primary" />
        <a asp-controller="Teachers" asp-action="Index" class="btn btn-secondary">Скасувати</a>
    </div>
</form>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}