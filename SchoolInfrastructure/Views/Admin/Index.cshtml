@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>
@using System.Collections.Generic

@{
    ViewData["Title"] = "Керування користувачами";
    var userRoles = ViewData["UserRoles"] as Dictionary<string, IList<string>>;
    var searchQuery = ViewData["SearchQuery"] as string ?? "";
    var selectedRole = ViewData["SelectedRole"] as string ?? "";
    var availableRoles = ViewData["AvailableRoles"] as List<string> ?? new List<string>();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <form method="get" asp-action="Index" class="d-flex gap-2 flex-wrap">
            <input type="text" name="search" class="form-control" placeholder="Пошук..." value="@searchQuery" />
            <select name="role" class="form-select">
                <option value="">Всі ролі</option>
                @foreach (var role in availableRoles)
                {
                    <option value="@role" selected="@(selectedRole == role)">@role</option>
                }
            </select>
            <button type="submit" class="btn btn-outline-secondary">Фільтрувати</button>
        </form>
        <div>
            <span class="fs-4 fw-bold">Користувачі</span>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <p>@error.ErrorMessage</p>
            }
        </div>
    }

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Користувач</th>
                        <th>Підтверджено Email</th>
                        <th>Ролі</th>
                        <th>Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.OrderByDescending(u => userRoles.ContainsKey(u.Id) && userRoles[u.Id].Contains("Admin")))
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar bg-light rounded-circle text-center me-3" style="width:40px; height:40px; line-height:40px;">
                                        @user.Email.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <div class="fw-bold">@user.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (user.EmailConfirmed)
                                {
                                    <span class="text-success"><i class="bi bi-check-circle-fill"></i> Так</span>
                                }
                                else
                                {
                                    <span class="text-danger"><i class="bi bi-x-circle-fill"></i> Ні</span>
                                }
                            </td>
                            <td>
                                @(userRoles.ContainsKey(user.Id) ? string.Join(", ", userRoles[user.Id]) : "Немає")
                            </td>
                            <td>
                                <div class="d-flex flex-column gap-1">
                                    <form asp-action="UpdateUserRoles" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <select name="selectedRoles" multiple class="form-select form-select-sm">
                                            <option value="Teacher" selected="@(userRoles.ContainsKey(user.Id) && userRoles[user.Id].Contains("Teacher"))">Викладач</option>
                                            <option value="Student" selected="@(userRoles.ContainsKey(user.Id) && userRoles[user.Id].Contains("Student"))">Студент</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-primary mt-1">Оновити</button>
                                    </form>

                                    <form asp-action="DeleteUser" method="post" onsubmit="return confirm('Ви впевнені, що хочете видалити користувача?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger">Видалити</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>