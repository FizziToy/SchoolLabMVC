@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Реєстрація";
}

<h1>@ViewData["Title"]</h1>
<h2 id="external-login-title">Прив’яжіть свій обліковий запис @Model.ProviderDisplayName.</h2>
<hr />

<p id="external-login-description" class="text-info">
    Ви успішно авторизувалися через <strong>@Model.ProviderDisplayName</strong>.
    Будь ласка, введіть свою електронну адресу для цього сайту нижче та натисніть кнопку "Реєстрація", щоб завершити вхід.
</p>


<div class="row">
    <div class="col-md-4">
        <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="пошта" placeholder="Будь ласка, введіть свою пошту."/>
                <label asp-for="Input.Email" class="form-label"></label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Зареєструватися</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
